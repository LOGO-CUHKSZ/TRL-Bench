# Local-only artifacts that aren't part of the public release
# (site-specific env activation, internal design specs, staged HF data,
# embedding/result caches the user produces locally). Anchored to repo
# root so they don't match e.g. src/trl_bench/data/.
/load_env
/docs/superpowers/
/data/
/embeddings/
/.remember/
.paper_reference/
grid_run/
results_grid/
results_grid_row/
embeddings_grid_row/
embeddings

# Local-only scratch output dirs (suffixed/wildcard forms not caught above);
# never part of the public release — run outputs produced locally.
embeddings_*/
emb_*/
results_*/
logs_*/
checkpoints_*/
*_ckpt/
*_venv/
canonical_ref/
data_freshtest/
*_results.txt

# Root-level SLURM job-array logs from grid runs
/slurm-*.out

# Diagnostic / repair output dirs (diag_wdc, diag_rl, diag_tabert_repair, ...)
/diag_*/

# Local model run-output dirs at repo root. Anchored to root so they never
# shadow the tracked model source under src/trl_bench/models/transtab/.
/transtab/
/transtab_var/

# Seed/family-suffixed checkpoint dirs not caught by *_ckpt/ above
# (e.g. tabtfvar_ckpt_42/, tabtffix512_ckpt_1/).
*_ckpt_*/

# One-off local scratch outputs
/valentine_wired_test/
/wtq_tablelist.txt

# Claude Code local tooling / session config
.claude/
